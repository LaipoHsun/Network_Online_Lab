---
import Base from '../layouts/Base.astro';
import { CHAPTERS, SEASONS } from '../data/chapters';
import { renderCharacter } from '../lib/sprites/character';
const base = import.meta.env.BASE_URL;
---
<Base title="網路實驗室">
  <section class="hero">
    <h1>你和陌生人之間，只隔幾個人？</h1>
    <p>網路實驗室用台大生活裡的場景、會走動的小人和真實的研究資料，帶你讀懂社會網路的數學結構，以及它在經濟學和社會學上的意義。每一章先讓你猜，再讓你動手，最後用真實資料揭曉答案。</p>
  </section>

  {SEASONS.map((s) => (
    <section class="season">
      <h2>{s.title}</h2>
      <p class="note">{s.note}</p>
      {s.n === 1 ? (
        <ol class="cards">
          {CHAPTERS.map((c) => (
            <li class="card" data-status={c.status}>
              <a href={`${base}s1/${c.slug}/`} aria-disabled={c.status === 'planned'}>
                <div class="hero-sprite" set:html={renderCharacter(c.hero.look, 'idle', { size: 54, title: `${c.hero.name}（${c.hero.dept}）` })} />
                <div class="meta">
                  <span class="num">第 {c.n} 章 · {c.hero.name}（{c.hero.dept}）</span>
                  <strong>{c.title}</strong>
                  <span class="concept">{c.concept}</span>
                  <span class="foot">{c.prereq.length ? `前置：${c.prereq.join('、')}` : '無前置'} · 約 {c.minutes} 分鐘 · {c.status === 'done' ? '可閱讀' : '製作中'}</span>
                </div>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="soon">規劃中</p>
      )}
    </section>
  ))}
</Base>
<style>
  .hero { max-width: 68ch; margin-bottom: var(--space-8); }
  .hero h1 { font-size: clamp(28px, 4vw, 40px); margin: var(--space-4) 0; }
  .season { margin-bottom: var(--space-8); }
  .season h2 { font-size: 22px; margin: 0 0 4px; }
  .note, .soon { color: var(--muted); margin: 0 0 var(--space-4); }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-4); }
  .card a { display: flex; gap: var(--space-4); padding: var(--space-4); background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink); text-decoration: none; height: 100%; }
  .card a:hover { border-color: var(--accent); }
  .card[data-status="planned"] a { pointer-events: none; }
  .hero-sprite { flex: none; width: 48px; display: grid; place-items: center; background: var(--accent-soft); border-radius: 10px; }
  .meta { display: flex; flex-direction: column; gap: 2px; line-height: 1.5; }
  .num { font-size: 13px; color: var(--accent); }
  .meta strong { font-size: 16px; }
  .concept { font-size: 14px; }
  .foot { font-size: 12px; color: var(--muted); margin-top: 4px; }
</style>
